  namespace tps.tp4 {
    abstract class tps.tp4.Person {
        - genero : String
        - idade : int
        - nome : String
        - number : String
        - password : String
        + Person()
        {abstract} + createElement()
        + getAge()
        + getGenero()
        + getName()
        + getNumber()
        + getPassword()
        {static} + isNameValid()
        {static} + isNumberValid()
        {static} + isPasswordValid()
        + login()
        {static} + removeExtraSpaces()
        + setIdade()
        + setNumber()
        + setPassword()
    }
  }
  

  namespace tps.tp4 {
    class tps.tp4.PersonalTrainer {
        ~ ptClients : ArrayList<String>
        {static} - MAX_CLIENTS : int
        {static} - clienteBonus : int
        - experiencia : int
        - numClientes : int
        + Bonus()
        + PersonalTrainer()
        + addClient()
        + createElement()
        + delClient()
        + getClients()
        + getExperiencia()
        + getIndexOfGymM()
        + setExperiencia()
        + toString()
        + uptadeSalario()
    }
  }
  

  tps.tp4.Client -up-|> tps.tp4.Person
  tps.tp4.Client o-- tps.tp4.Pack : pack
  tps.tp4.Employee -up-|> tps.tp4.Person
  tps.tp4.PersonalTrainer -up-|> tps.tp4.Employee


