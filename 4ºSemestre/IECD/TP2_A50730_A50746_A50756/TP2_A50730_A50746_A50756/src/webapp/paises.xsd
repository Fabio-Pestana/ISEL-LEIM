<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="nacionalidades">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="masculinas" type="listaNacionalidades"/>
                <xs:element name="femininas" type="listaNacionalidades"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="listaNacionalidades">
        <xs:sequence>
            <xs:element name="nacionalidade" type="xs:string" minOccurs="1" maxOccurs="500"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
