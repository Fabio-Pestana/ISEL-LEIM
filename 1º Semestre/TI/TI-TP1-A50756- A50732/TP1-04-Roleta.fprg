<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="fabio"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2022-10-18 10:48:35 "/>
        <attribute name="created" value="ZmFiaW87TEFQVE9QLVZMRDIwSUc3OzIwMjItMTAtMTg7IjEwOjI3OjEyICI7MjczMw=="/>
        <attribute name="edited" value="ZmFiaW87TEFQVE9QLVZMRDIwSUc3OzIwMjItMTAtMTg7IjEwOjQ4OjM1ICI7MjsyODUw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="x, r" type="Integer" array="False" size=""/>
            <output expression="&quot; introduza um numero entre 0 e 36&quot;" newline="True"/>
            <input variable="x"/>
            <if expression="x&gt;36">
                <then>
                    <output expression="&quot;######error404&quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="r" expression="random(37)"/>
                    <if expression="x==r">
                        <then>
                            <output expression="&quot;U won ;) &quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;U lost :( &quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
