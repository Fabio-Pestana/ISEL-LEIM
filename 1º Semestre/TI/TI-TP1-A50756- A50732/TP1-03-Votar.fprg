    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="anodeN, idade" type="Integer" array="False" size=""/>
            <output expression="&quot;Indique o ano do seu nascimneto &quot;" newline="True"/>
            <input variable="anodeN"/>
            <assign variable="idade" expression="2022 - anodeN"/>
            <if expression="idade &gt;= 18">
                <then>
                    <output expression="&quot;O individuo poder&#225; votar nestas elei&#231;&#245;es! &quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;O individuo n&#227;o pode votar! &quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
