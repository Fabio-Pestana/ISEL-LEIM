    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="x, s, r, a" type="Integer" array="False" size=""/>
            <output expression="&quot;insira um numero&quot;" newline="True"/>
            <input variable="x"/>
            <assign variable="s" expression="0"/>
            <assign variable="r" expression="0"/>
            <while expression="r!=x">
                <assign variable="r" expression="x%10"/>
                <assign variable="s" expression="s+r"/>
                <assign variable="x" expression="x/10"/>
            </while>
            <output expression="&quot;O valor da soma dos digitos inseridos &#233;: &quot; &amp; s" newline="True"/>
        </body>
    </function>
</flowgorithm>
