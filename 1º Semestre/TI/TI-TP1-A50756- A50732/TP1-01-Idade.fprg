    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="anoN, idade" type="Integer" array="False" size=""/>
            <output expression="&quot;Insira o ano em que nasceu &quot;" newline="True"/>
            <input variable="anoN"/>
            <assign variable="idade" expression="2022 - anoN"/>
            <output expression="&quot;Nasceu no ano de &quot; &amp; anoN &amp; &quot; e no ano de 2022 tem &quot; &amp; idade &amp; &quot; anos.&quot;" newline="True"/>
        </body>
    </function>
