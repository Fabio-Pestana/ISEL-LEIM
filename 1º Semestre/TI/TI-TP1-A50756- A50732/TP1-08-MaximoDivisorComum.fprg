    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, r" type="Integer" array="False" size=""/>
            <output expression="&quot;insira dois numeros positivos&quot;" newline="True"/>
            <input variable="a"/>
            <input variable="b"/>
            <if expression="a&lt;0 || b&lt;0">
                <then>
                    <output expression="&quot;Pelo menos um dos numeros inseridos &#233; negativo, pela qual impede o programa de prosseguir.&quot;" newline="True"/>
                </then>
                <else>
                    <while expression="b!=0">
                        <assign variable="r" expression="a % b"/>
                        <assign variable="a" expression="b"/>
                        <assign variable="b" expression="r"/>
                    </while>
                    <output expression="a" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
