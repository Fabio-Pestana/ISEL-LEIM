    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c, d" type="Integer" array="False" size=""/>
            <output expression="&quot;Introduza dois numeros: &quot;" newline="True"/>
            <input variable="a"/>
            <input variable="b"/>
            <assign variable="c" expression="b - a"/>
            <assign variable="d" expression="random(c+1)+a"/>
            <output expression="d" newline="True"/>
        </body>
    </function>
